PLAYGROUND_HUB_URL=https://modelmarket.dev
PLAYGROUND_METIS_URL=https://metis.modelmarket.dev
# Server-only Bearer credential for an authenticated production Metis. Never expose it to browser code.
PLAYGROUND_METIS_KEY=
PLAYGROUND_GAIA_URL=https://iot.modelmarket.dev
PLAYGROUND_MONITOR_URL=https://monitor.modelmarket.dev/
# Optional ingestion endpoint. A failed visibility event never fails an invoke.
PLAYGROUND_EVENT_URL=
PLAYGROUND_EVENT_TOKEN=
PLAYGROUND_MAX_RUNS_PER_HOUR=5
PLAYGROUND_MAX_RUNS_PER_SOURCE_PER_HOUR=25
PLAYGROUND_MAX_GLOBAL_RUNS_PER_HOUR=500
PLAYGROUND_MAX_CONCURRENCY=8
PLAYGROUND_RUN_TIMEOUT_S=640
PLAYGROUND_METIS_TIMEOUT_S=620
PLAYGROUND_METIS_ROUTE=fast
PLAYGROUND_MAX_RESPONSE_BYTES=262144
PLAYGROUND_MAX_STORED_RUNS=100
# Local/self-host only. Public deployments must keep HTTPS upstreams.
PLAYGROUND_ALLOW_INSECURE_UPSTREAMS=0
